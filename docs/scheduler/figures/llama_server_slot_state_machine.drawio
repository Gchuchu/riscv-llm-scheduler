<mxfile host="Electron" modified="2026-07-19T14:19:57.527Z" version="30.3.6">
  <diagram id="live-page" name="Slot State Machine">
<mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#172554;fontSize=24;" value="llama-server 单个 Slot 状态机（文本生成主路径）" vertex="1"><mxGeometry height="40" width="760" x="235" y="40" as="geometry"/></mxCell><mxCell id="subtitle" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#475569;fontSize=13;" value="状态由 server_slot.state 驱动；前向图完成后由 post_decode 处理 logits 与采样" vertex="1"><mxGeometry height="28" width="730" x="245" y="82" as="geometry"/></mxCell><mxCell id="idle" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=16;" value="IDLE" vertex="1"><mxGeometry height="62" width="130" x="80" y="300" as="geometry"/></mxCell><mxCell id="started" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=16;" value="STARTED" vertex="1"><mxGeometry height="62" width="150" x="290" y="300" as="geometry"/></mxCell><mxCell id="wait_other" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=14;" value="WAIT_OTHER&#10;parallel sampling 子任务&#10;等待父 slot 的 prompt/KV 状态" vertex="1"><mxGeometry height="86" width="200" x="270" y="475" as="geometry"/></mxCell><mxCell id="processing_prompt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontSize=15;" value="PROCESSING_PROMPT&#10;分块 Prefill&#10;写入 KV cache" vertex="1"><mxGeometry height="100" width="220" x="520" y="280" as="geometry"/></mxCell><mxCell id="done_prompt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=15;" value="DONE_PROMPT&#10;最后一个 prompt token&#10;已进入 batch" vertex="1"><mxGeometry height="100" width="190" x="810" y="280" as="geometry"/></mxCell><mxCell id="generating" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;fontColor=#581C87;fontSize=16;" value="GENERATING&#10;Decode" vertex="1"><mxGeometry height="62" width="160" x="1070" y="300" as="geometry"/></mxCell><mxCell id="note" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#334155;fontSize=13;" value="注 1：WAIT_OTHER 仅用于 parallel sampling（n_cmpl &gt; 1）；普通独立请求不会进入此状态。注 2：分块 prefill 的前向完成不会采样，只有 DONE_PROMPT 且 slot.i_batch 完成时才采样首 token。" vertex="1"><mxGeometry height="38" width="960" x="180" y="650" as="geometry"/></mxCell><mxCell id="e_idle_started" edge="1" parent="1" source="idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#475569;strokeWidth=2;endArrow=block;" target="started" value="分配 task"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_started_processing" edge="1" parent="1" source="started" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;" target="processing_prompt" value="开始处理 prompt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_started_wait" edge="1" parent="1" source="started" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeOpacity=0;fontOpacity=0;endArrow=none;" target="wait_other" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="365" y="420"/></Array></mxGeometry></mxCell><mxCell id="e_wait_processing" edge="1" parent="1" source="wait_other" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeOpacity=0;fontOpacity=0;endArrow=none;" target="processing_prompt" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="520"/><mxPoint x="490" y="430"/></Array></mxGeometry></mxCell><mxCell id="e_processing_done" edge="1" parent="1" source="processing_prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;" target="done_prompt" value="所有 prompt tokens&#10;已加入当前 batch"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_processing_loop" edge="1" parent="1" source="processing_prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#0284C7;strokeWidth=2;endArrow=block;" target="processing_prompt" value="prompt 未完成&#10;下一 server batch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="205"/><mxPoint x="770" y="205"/></Array></mxGeometry></mxCell><mxCell id="e_done_generating" edge="1" parent="1" source="done_prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#16A34A;strokeWidth=2;endArrow=block;" target="generating" value="logits -&gt; 首 token"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_generating_loop" edge="1" parent="1" source="generating" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#9333EA;strokeWidth=2;endArrow=block;" target="generating" value="普通 decode：已采样 token&#10;进入下一 batch"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="205"/><mxPoint x="1285" y="205"/></Array></mxGeometry></mxCell><mxCell id="e_generating_idle" edge="1" parent="1" source="generating" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#64748B;strokeWidth=2;endArrow=block;" target="idle" value="EOG / stop / max tokens&#10;发送最终响应，release slot"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="590"/><mxPoint x="145" y="590"/></Array></mxGeometry></mxCell><mxCell id="e_idle_wait" edge="1" parent="1" source="idle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;" target="wait_other" value="分配子任务&#10;parallel sampling (n_cmpl &gt; 1)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="440"/><mxPoint x="250" y="440"/></Array></mxGeometry></mxCell><mxCell id="e_wait_done" edge="1" parent="1" source="wait_other" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#D97706;strokeWidth=2;endArrow=block;" target="done_prompt" value="复制父 KV / prompt 进度&#10;初始化子 sampler -&gt; DONE_PROMPT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="520"/><mxPoint x="550" y="430"/><mxPoint x="905" y="430"/></Array></mxGeometry></mxCell><mxCell id="exit_note" parent="1" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#475569;fontSize=13;" value="例外路径：embedding / rerank 在 DONE_PROMPT 完成后直接 release() -&gt; IDLE；取消、异常或 batch 失败也会从任意活动状态 release() -&gt; IDLE。" vertex="1"><mxGeometry height="36" width="980" x="170" y="710" as="geometry"/></mxCell><mxCell id="e_done_idle_non_generation" edge="1" parent="1" source="done_prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endFill=1;strokeColor=#64748B;strokeWidth=1;dashed=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.72;entryY=1;" target="idle" value="embedding / rerank 完成&#10;release()"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="625"/><mxPoint x="155" y="625"/></Array></mxGeometry></mxCell></root></mxGraphModel>
  </diagram>
